{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agentlaw action input",
  "description": "Executable contract shared by MCP and CLI. Choose the action and supply its required fields. Use recall for context, remember_this for memory and procedure updates, history for past changes, and connect_project_memory for a verified project folder.",
  "$comment": "Runtime validation contract, not the model-facing tool descriptor. agentlaw-tool.schema.json presents explicit typed fields and usage guidance. Runtime also validates identity existence, current heads, scope, confirmation, review references, Task Markdown headings and publication safety.",
  "type": "object",
  "oneOf": [
    {
      "$ref": "#/$defs/recall"
    },
    {
      "$ref": "#/$defs/rememberInitial"
    },
    {
      "$ref": "#/$defs/pendingInspect"
    },
    {
      "$ref": "#/$defs/pendingContinue"
    },
    {
      "$ref": "#/$defs/pendingDiscard"
    },
    {
      "$ref": "#/$defs/procedureAuthoring"
    },
    {
      "$ref": "#/$defs/procedureWrite"
    },
    {
      "$ref": "#/$defs/history"
    },
    {
      "$ref": "#/$defs/connectProjectMemory"
    }
  ],
  "$defs": {
    "memoryRef": {
      "type": "object",
      "properties": {
        "memory_id": {
          "type": "string",
          "minLength": 1,
          "description": "Copy memory_id from the returned memory_ref."
        },
        "observed_version": {
          "type": "string",
          "minLength": 1,
          "description": "Copy observed_version unchanged. Never compute or guess it."
        }
      },
      "required": [
        "memory_id",
        "observed_version"
      ],
      "additionalProperties": false
    },
    "procedureRef": {
      "type": "object",
      "properties": {
        "procedure_id": {
          "type": "string",
          "minLength": 1
        },
        "observed_version": {
          "type": "string",
          "minLength": 1,
          "description": "Copy the returned procedure version unchanged."
        }
      },
      "required": [
        "procedure_id",
        "observed_version"
      ],
      "additionalProperties": false
    },
    "pendingRef": {
      "type": "object",
      "properties": {
        "pending_batch_id": {
          "type": "string",
          "minLength": 1
        },
        "observed_version": {
          "type": "string",
          "minLength": 1,
          "description": "Copy the latest returned pending batch version."
        }
      },
      "required": [
        "pending_batch_id",
        "observed_version"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Verified project-relative path. No absolute path or parent traversal."
        },
        "kind": {
          "enum": [
            "file",
            "directory"
          ]
        }
      },
      "required": [
        "path",
        "kind"
      ],
      "additionalProperties": false
    },
    "storedTarget": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "description": "Copy the target project's known identity."
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Project-relative path."
        },
        "kind": {
          "enum": [
            "file",
            "directory"
          ]
        },
        "reading": {
          "enum": [
            "related",
            "required"
          ]
        }
      },
      "required": [
        "project_id",
        "path",
        "kind",
        "reading"
      ],
      "additionalProperties": false
    },
    "memoryProposal": {
      "type": "object",
      "properties": {
        "operation": {
          "enum": [
            "create",
            "evolve",
            "consolidate"
          ],
          "description": "Choose explicitly. Evolve uses every current head of one identity; consolidate uses every current head of at least two identities."
        },
        "what_to_remember": {
          "type": "string",
          "minLength": 1,
          "description": "Write the complete, coherent current understanding, preserving applicable conditions and exceptions. When evolving a memory, replace its current text rather than appending a chronological log. For task memory, use Objective / Current position / Resume point / References to capture user intent, the current choice and rationale, verification status, unresolved questions, and the next check. Keep the rationale needed to continue in the task itself; reference independent memories and the Plan without duplicating their full texts."
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "description": "Record observations, user corrections or decisions, and verification supporting this update. Preserve new occurrences, conditions, and supporting evidence even when the conclusion is unchanged. Distinguish observations from hypotheses."
        },
        "applies_to": {
          "type": "array",
          "enum": [
            [
              "user"
            ],
            [
              "project"
            ],
            [
              "machine"
            ],
            [
              "project",
              "machine"
            ]
          ]
        },
        "parent_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/memoryRef"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "consolidation_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/memoryRef"
          },
          "minItems": 2,
          "uniqueItems": true
        },
        "in_working_set": {
          "type": "boolean",
          "description": "Omit for non-Task memory. For a Task, true means future work must resume it; false means it has completed, been cancelled, or been superseded. Use Objective / Current position / Resume point / References headings exactly once in that order."
        },
        "is_rule": {
          "type": "boolean",
          "description": "Use true only for explicitly established standing rules; evidence must support that intent."
        },
        "related_memory_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "required_memory_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "work_targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/storedTarget"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "proposal_id": {
          "type": "string",
          "minLength": 1,
          "description": "Only copy an existing proposal_id when replacing a retained pending proposal. Omit for a new proposal."
        }
      },
      "required": [
        "operation",
        "what_to_remember",
        "evidence"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "const": "create"
              }
            }
          },
          "then": {
            "required": [
              "applies_to"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "parent_refs"
                  ]
                },
                {
                  "required": [
                    "consolidation_refs"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "evolve"
              }
            }
          },
          "then": {
            "required": [
              "parent_refs"
            ],
            "not": {
              "required": [
                "consolidation_refs"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "consolidate"
              }
            }
          },
          "then": {
            "required": [
              "consolidation_refs"
            ],
            "not": {
              "required": [
                "parent_refs"
              ]
            }
          }
        }
      ]
    },
    "recall": {
      "type": "object",
      "properties": {
        "action": {
          "const": "recall"
        },
        "project_path": {
          "type": "string",
          "minLength": 1,
          "description": "Absolute project folder path verified in the harness work environment; never infer it from Agentlaw's process cwd."
        },
        "project_hint": {
          "type": "string",
          "minLength": 1,
          "description": "Observed name or description of a different project to query; this does not rebind the current folder."
        },
        "selected_project_id": {
          "type": "string",
          "minLength": 1,
          "description": "Copy a project candidate ID and repeat the same project_hint."
        },
        "machine_id": {
          "type": "string",
          "minLength": 1,
          "description": "Copy a known machine ID for explicit cross-machine lookup; omission uses the installation environment."
        },
        "recall_for": {
          "type": "string",
          "minLength": 1,
          "description": "Describe the current task or question. For follow-up recall, include the new observation and what now needs checking. Reuse available results when the question and conditions are unchanged. Omit for ID-only lookup."
        },
        "search_terms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "Use known literal terms such as commands, paths, names, or error messages; these are search clues, not returned IDs."
          }
        },
        "memory_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "Copy a returned identity; do not invent one."
          }
        },
        "procedure_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "Copy a returned identity; do not invent one."
          }
        },
        "restore_context": {
          "type": "boolean",
          "description": "Set true to retrieve applicable standing rules and discover project context from multiple perspectives. Omit for ordinary recall. This does not mark a session as restored or replace explicit Task selection."
        },
        "include_active_tasks": {
          "type": "boolean"
        },
        "memory_candidate_limit": {
          "type": "integer",
          "minimum": 1
        },
        "procedure_candidate_limit": {
          "type": "integer",
          "minimum": 1
        },
        "work_targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "recall_for"
          ]
        },
        {
          "required": [
            "memory_ids"
          ]
        },
        {
          "required": [
            "procedure_ids"
          ]
        }
      ],
      "dependentRequired": {
        "selected_project_id": [
          "project_hint"
        ],
        "search_terms": [
          "recall_for"
        ],
        "restore_context": [
          "recall_for"
        ],
        "include_active_tasks": [
          "recall_for"
        ],
        "memory_candidate_limit": [
          "recall_for"
        ],
        "procedure_candidate_limit": [
          "recall_for"
        ],
        "work_targets": [
          "recall_for"
        ]
      }
    },
    "rememberInitial": {
      "type": "object",
      "properties": {
        "action": {
          "const": "remember_this"
        },
        "project_path": {
          "type": "string",
          "minLength": 1,
          "description": "Absolute project folder path verified in the harness work environment; never infer it from Agentlaw's process cwd."
        },
        "resolution_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Copy the returned resolution_ref after reviewing its issues. This is not a pending batch ID or idempotency key."
        },
        "memories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/memoryProposal"
              },
              {
                "not": {
                  "required": [
                    "proposal_id"
                  ]
                }
              }
            ]
          }
        }
      },
      "required": [
        "action",
        "memories"
      ],
      "additionalProperties": false
    },
    "pendingInspect": {
      "type": "object",
      "properties": {
        "action": {
          "const": "remember_this"
        },
        "pending_batch_ref": {
          "$ref": "#/$defs/pendingRef"
        },
        "pending_action": {
          "const": "inspect"
        }
      },
      "required": [
        "action",
        "pending_batch_ref",
        "pending_action"
      ],
      "additionalProperties": false
    },
    "pendingContinue": {
      "type": "object",
      "properties": {
        "action": {
          "const": "remember_this"
        },
        "pending_batch_ref": {
          "$ref": "#/$defs/pendingRef"
        },
        "pending_action": {
          "const": "continue"
        },
        "project_path": {
          "type": "string",
          "minLength": 1,
          "description": "Absolute project folder path verified in the harness work environment; never infer it from Agentlaw's process cwd."
        },
        "resolution_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Copy the returned resolution_ref after reviewing its issues. This is not a pending batch ID or idempotency key."
        },
        "memories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/memoryProposal"
          }
        },
        "review_judgments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "review_ref": {
                "type": "string",
                "minLength": 1,
                "description": "Copy the review reference for the exact presented dependency state."
              },
              "decision": {
                "const": "unchanged"
              }
            },
            "required": [
              "review_ref",
              "decision"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "action",
        "pending_batch_ref",
        "pending_action"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "memories"
          ]
        },
        {
          "required": [
            "review_judgments"
          ]
        },
        {
          "required": [
            "resolution_ref"
          ]
        }
      ]
    },
    "pendingDiscard": {
      "type": "object",
      "properties": {
        "action": {
          "const": "remember_this"
        },
        "pending_batch_ref": {
          "$ref": "#/$defs/pendingRef"
        },
        "pending_action": {
          "const": "discard"
        },
        "discard_reason": {
          "type": "string",
          "minLength": 1
        },
        "user_confirmed": {
          "const": true
        }
      },
      "required": [
        "action",
        "pending_batch_ref",
        "pending_action",
        "discard_reason",
        "user_confirmed"
      ],
      "additionalProperties": false
    },
    "procedureStart": {
      "type": "object",
      "properties": {
        "operation": {
          "enum": [
            "create",
            "evolve"
          ]
        },
        "parent_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/procedureRef"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "evidence_memory_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "Copy a returned identity; do not invent one."
          }
        },
        "applies_to": {
          "type": "array",
          "enum": [
            [
              "user"
            ],
            [
              "project"
            ],
            [
              "machine"
            ],
            [
              "project",
              "machine"
            ]
          ]
        }
      },
      "required": [
        "operation",
        "evidence_memory_ids"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "const": "create"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "parent_refs"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "evolve"
              }
            }
          },
          "then": {
            "required": [
              "parent_refs"
            ]
          }
        }
      ]
    },
    "procedureFinal": {
      "type": "object",
      "properties": {
        "operation": {
          "enum": [
            "create",
            "evolve"
          ]
        },
        "parent_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/procedureRef"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "evidence_memory_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "Copy a returned identity; do not invent one."
          }
        },
        "applies_to": {
          "type": "array",
          "enum": [
            [
              "user"
            ],
            [
              "project"
            ],
            [
              "machine"
            ],
            [
              "project",
              "machine"
            ]
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Action-oriented procedure name."
        },
        "use_when": {
          "type": "string",
          "minLength": 1,
          "description": "One sentence describing when to use this procedure."
        },
        "instructions": {
          "type": "string",
          "minLength": 1,
          "description": "Complete instruction-only procedure, coherently rewritten rather than appended."
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "description": "Record observations, user corrections or decisions, and verification supporting this update. Preserve new occurrences, conditions, and supporting evidence even when the conclusion is unchanged. Distinguish observations from hypotheses."
        }
      },
      "required": [
        "operation",
        "evidence_memory_ids",
        "name",
        "use_when",
        "instructions",
        "evidence"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "const": "create"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "parent_refs"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "evolve"
              }
            }
          },
          "then": {
            "required": [
              "parent_refs"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "create"
              }
            }
          },
          "then": {
            "required": [
              "applies_to"
            ]
          }
        }
      ]
    },
    "procedureAuthoring": {
      "type": "object",
      "properties": {
        "action": {
          "const": "remember_this"
        },
        "project_path": {
          "type": "string",
          "minLength": 1,
          "description": "Absolute project folder path verified in the harness work environment; never infer it from Agentlaw's process cwd."
        },
        "procedure": {
          "$ref": "#/$defs/procedureStart"
        }
      },
      "required": [
        "action",
        "procedure"
      ],
      "additionalProperties": false
    },
    "procedureWrite": {
      "type": "object",
      "properties": {
        "action": {
          "const": "remember_this"
        },
        "project_path": {
          "type": "string",
          "minLength": 1,
          "description": "Absolute project folder path verified in the harness work environment; never infer it from Agentlaw's process cwd."
        },
        "authoring_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Copy the returned authoring reference after using the current built-in writing guidance."
        },
        "procedure": {
          "$ref": "#/$defs/procedureFinal"
        }
      },
      "required": [
        "action",
        "authoring_ref",
        "procedure"
      ],
      "additionalProperties": false
    },
    "history": {
      "type": "object",
      "properties": {
        "action": {
          "const": "history"
        },
        "memory_id": {
          "type": "string",
          "minLength": 1
        },
        "procedure_id": {
          "type": "string",
          "minLength": 1
        },
        "context_layers": {
          "type": "integer",
          "minimum": 0
        },
        "history_for": {
          "type": "string",
          "minLength": 1
        },
        "max_matches": {
          "type": "integer",
          "minimum": 1
        },
        "start_change_id": {
          "type": "string",
          "minLength": 1
        },
        "end_change_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "memory_id"
              ],
              "not": {
                "required": [
                  "procedure_id"
                ]
              }
            },
            {
              "required": [
                "procedure_id"
              ],
              "not": {
                "required": [
                  "memory_id"
                ]
              }
            }
          ]
        },
        {
          "oneOf": [
            {
              "required": [
                "context_layers"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "history_for"
                    ]
                  },
                  {
                    "required": [
                      "max_matches"
                    ]
                  },
                  {
                    "required": [
                      "start_change_id"
                    ]
                  },
                  {
                    "required": [
                      "end_change_id"
                    ]
                  }
                ]
              }
            },
            {
              "required": [
                "context_layers",
                "history_for",
                "max_matches"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "start_change_id"
                    ]
                  },
                  {
                    "required": [
                      "end_change_id"
                    ]
                  }
                ]
              }
            },
            {
              "required": [
                "start_change_id",
                "end_change_id"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "context_layers"
                    ]
                  },
                  {
                    "required": [
                      "history_for"
                    ]
                  },
                  {
                    "required": [
                      "max_matches"
                    ]
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    "connectProjectMemory": {
      "type": "object",
      "properties": {
        "action": {
          "const": "connect_project_memory"
        },
        "project_path": {
          "type": "string",
          "minLength": 1,
          "description": "Absolute project folder path verified in the harness work environment; never infer it from Agentlaw's process cwd."
        },
        "intent": {
          "enum": [
            "discover",
            "connect",
            "create"
          ]
        },
        "clues": {
          "type": "object",
          "properties": {
            "repository_url": {
              "type": "string",
              "minLength": 1,
              "description": "Only an observed repository URL, not Agentlaw's or the memory store's remote."
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [],
          "additionalProperties": false,
          "minProperties": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "project_name": {
          "type": "string",
          "minLength": 1
        },
        "project_description": {
          "type": "string",
          "minLength": 1
        },
        "memory_store_path": {
          "type": "string",
          "minLength": 1,
